flowchart TD
    START(["开始"])
    INIT{{"初始化 Data_pst 指向<br>Gp_TLF35584_rtData_ltst"}}
    UNLOCK[["Gp_TLF35584_UnlockSeq<br>解锁序列"]]
    WRITE_CMD_1[/"调用 Gp_TLF35584_WriteCmd<br>写入 WDCFG0 寄存器<br>参数<br>GP_TLF35584_DISABLE_WDG_ER<br>RPIN<br>结果存入 TxBuf_au16[0U]/"]
    WRITE_CMD_2[/"调用 Gp_TLF35584_WriteCmd<br>写入 SYSPCFG1 寄存器<br>参数<br>GP_TLF35584_DISABLE_WDG_ER<br>RPIN<br>结果存入 TxBuf_au16[1U]/"]
    SET_CNT["设置 CntTx_u16 为 2U"]
    TRANSMIT[["Gp_TLF35584_TransmitData<br>发送数据<br>参数 CntTx_u16"]]
    LOCK[["Gp_TLF35584_LockSeq<br>锁定序列"]]
    END(["结束"])

    START --> INIT
    INIT --> UNLOCK
    UNLOCK --> WRITE_CMD_1
    WRITE_CMD_1 --> WRITE_CMD_2
    WRITE_CMD_2 --> SET_CNT
    SET_CNT --> TRANSMIT
    TRANSMIT --> LOCK
    LOCK --> END